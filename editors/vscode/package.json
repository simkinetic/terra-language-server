{
  "name": "terra-lsp",
  "displayName": "Terra Language Server",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onLanguage:terra"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "terra",
        "aliases": [
          "Terra",
          "terra"
        ],
        "extensions": [
          ".terra",
          ".t"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.1.6"
  }
}
